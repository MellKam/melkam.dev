---
import Base from "../layouts/Base.astro";

interface PostFrontmatter {
	title: string;
	description: string;
	pubDate: string;
}

// Every markdown file in src/pages/blog/ is a post. Adding one is all it takes
// to have it show up here.
const posts = Object.values(
	import.meta.glob<{ frontmatter: PostFrontmatter; url: string }>(
		"./blog/*.md",
		{ eager: true },
	),
).sort(
	(a, b) =>
		new Date(b.frontmatter.pubDate).valueOf() -
		new Date(a.frontmatter.pubDate).valueOf(),
);
---

<Base
	title="Artem Melnyk"
	description="Notes on compilers, WebAssembly and language design."
>
	<div class="mx-auto max-w-5xl px-6 sm:px-8">
		<section class="flex items-center gap-3 py-20 sm:py-28">
			<img
				src="/favicon.svg"
				class="size-12 shrink-0 select-none sm:size-16"
				alt=""
				width="64"
				height="64"
			/>
			<h1
				class="text-4xl font-medium tracking-tight sm:text-6xl"
			>
				Artem Melnyk
			</h1>
		</section>

		<section class="pb-24">
			<h2 class="text-sm font-medium text-subtle">Writing</h2>
			<ul class="mt-6 border-t border-line">
				{
					posts.map((post) => (
						<li class="border-b border-line">
							<a
								href={post.url}
								class="group flex flex-col gap-1 py-6 sm:flex-row sm:items-baseline sm:gap-8"
							>
								<time
									datetime={post.frontmatter.pubDate}
									class="shrink-0 text-sm text-subtle tabular-nums sm:w-28"
								>
									{new Date(
										post.frontmatter.pubDate,
									).toLocaleDateString("en-GB", {
										day: "numeric",
										month: "short",
										year: "numeric",
									})}
								</time>
								<div class="min-w-0">
									<h3 class="font-medium tracking-tight transition-colors group-hover:text-accent">
										{post.frontmatter.title}
									</h3>
									<p class="mt-1 text-muted text-pretty">
										{post.frontmatter.description}
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Base>
